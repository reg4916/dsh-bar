{
  "name": "dsh-bar",
  "version": "0.3.0",
  "description": "Host half of DSH Bar: exposes live DeepSeek Harness session state to the macOS menu bar app over loopback HTTP.",
  "license": "MIT",
  "author": "reg4916",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "macos",
    "menu-bar",
    "status"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reg4916/dsh-bar.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/reg4916/dsh-bar",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/state.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
